# Copy to .env.vnpay.local (gitignored), or set BREWLITE_VNPAY_ENV_FILE.
# Only npm run dev:vnpay reads this optional overlay. Never commit real values.
VNPAY_ENV=SANDBOX
VNPAY_VERSION=2.1.0
VNPAY_TMN_CODE=YOURCODE
VNPAY_HASH_SECRET=replace_with_merchant_issued_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Register these exact URLs with your merchant before running; launcher never edits them.
VNPAY_RETURN_URL=https://your-registered-host.example/payments/vnpay/return
VNPAY_IPN_URL=https://your-registered-host.example/payments/vnpay/ipn
# Absolute path to your PRIVATE ngrok agent configuration containing your token.
# On Windows use forward slashes or literal backslashes in an unquoted dotenv value.
BREWLITE_NGROK_CONFIG=C:/path/to/private/ngrok.yml
# Optional if ngrok is not on PATH:
# BREWLITE_NGROK_BIN=C:/path/to/ngrok.exe
