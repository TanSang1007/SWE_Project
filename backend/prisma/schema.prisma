// Docs/DATABASE_DESIGN.md: structural schema; SQL CHECK constraints and the
// partial payment-success unique index are maintained in migrations.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LoyaltyRedemptionState {
  NONE
  RESERVED
  RELEASED
  SETTLED
  REFUNDED
}

enum LoyaltyEntryKind {
  OPENING
  RESERVE
  SETTLE
  RELEASE
  EARN
  REFUND
  REVERSE
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
  VNPAY
  ZERO_TOTAL
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
}

enum IdempotencyOperation {
  CREATE_ORDER
  PAY_ORDER
  ADJUST_INVENTORY
}

enum IdempotencyState {
  PROCESSING
  COMPLETED
}

enum PaymentProvider {
  MOCK
  VNPAY_SANDBOX
  INTERNAL_ZERO
}

enum GatewayState {
  AWAITING
  UNKNOWN
  SUCCEEDED
  FAILED
}

enum GatewayApplicationState {
  PENDING
  APPLIED
  REVIEW
}

enum VerificationSource {
  IPN
  QUERYDR
}

enum VerificationState {
  REQUESTED
  VERIFIED
  UNRESOLVED
}

model PaymentAttempt {
  id                   String                  @id @default(uuid()) @db.Uuid
  orderId              String                  @map("order_id") @db.Uuid
  idempotencyRequestId String                  @unique @map("idempotency_request_id") @db.Uuid
  provider             PaymentProvider         @default(VNPAY_SANDBOX)
  merchantCode         String                  @map("merchant_code") @db.VarChar(8)
  txnRef               String                  @unique @map("txn_ref") @db.VarChar(32)
  amount               Decimal                 @db.Decimal(12, 0)
  currency             String                  @default("VND") @db.Char(3)
  state                GatewayState            @default(AWAITING)
  applicationState     GatewayApplicationState @default(PENDING) @map("application_state")
  transactionNo        String?                 @map("transaction_no") @db.VarChar(15)
  responseCode         String?                 @map("response_code") @db.Char(2)
  transactionStatus    String?                 @map("transaction_status") @db.Char(2)
  createDate           String                  @map("create_date") @db.Char(14)
  expiresAt            DateTime                @map("expires_at") @db.Timestamptz(6)
  providerPaidAt       DateTime?               @map("provider_paid_at") @db.Timestamptz(6)
  verifiedAt           DateTime?               @map("verified_at") @db.Timestamptz(6)
  appliedAt            DateTime?               @map("applied_at") @db.Timestamptz(6)
  reviewReason         String?                 @map("review_reason") @db.VarChar(64)
  requestParameters    Json                    @map("request_parameters") @db.JsonB
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  order                Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyRequest   IdempotencyRequest      @relation(fields: [idempotencyRequestId], references: [id], onDelete: Restrict)
  payment              Payment?
  verifications        PaymentVerification[]
  loyaltyEntries       LoyaltyEntry[]

  @@unique([merchantCode, transactionNo])
  @@index([orderId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("payment_attempts")
}

model PaymentVerification {
  id              String             @id @default(uuid()) @db.Uuid
  attemptId       String             @map("attempt_id") @db.Uuid
  source          VerificationSource
  state           VerificationState
  requestId       String?            @unique @map("request_id") @db.VarChar(32)
  queryCreateDate String?            @map("query_create_date") @db.Char(14)
  payloadHash     String?            @map("payload_hash") @db.Char(64)
  payload         Json?              @db.JsonB
  errorCode       String?            @map("error_code") @db.VarChar(64)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  attempt         PaymentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, source, payloadHash])
  @@index([attemptId, receivedAt, id])
  @@map("payment_verifications")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.Text
  passwordHash  String   @map("password_hash") @db.Text
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  loyaltyDebt   BigInt   @default(0) @map("loyalty_debt")
  role          UserRole @default(CUSTOMER)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  orders              Order[]
  cart                Cart?
  payments            Payment[]
  loyaltyAwards       LoyaltyAward[]
  idempotencyRequests IdempotencyRequest[]
  loyaltyEntries      LoyaltyEntry[]
  authSessions        AuthSession[]

  @@map("users")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Text
  price     Decimal  @db.Decimal(12, 0)
  imageUrl  String   @map("image_url") @db.Text
  stock     Int
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  sizes     ProductSize[]
  toppings  ProductTopping[]
  items     OrderItem[]
  cartItems CartItem[]

  @@map("products")
}

model ProductSize {
  productId  String     @map("product_id") @db.Uuid
  size       String     @db.Text
  extraPrice Decimal    @map("extra_price") @db.Decimal(12, 0)
  isActive   Boolean    @default(true) @map("is_active")
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]

  @@id([productId, size])
  @@map("product_sizes")
}

model Topping {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Text
  price     Decimal  @db.Decimal(12, 0)
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  products  ProductTopping[]
  items     OrderItemTopping[]
  cartItems CartItemTopping[]

  @@map("toppings")
}

model ProductTopping {
  productId String  @map("product_id") @db.Uuid
  toppingId String  @map("topping_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([productId, toppingId])
  @@index([toppingId])
  @@map("product_toppings")
}

model Promotion {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.Text
  discountAmount  Decimal  @map("discount_amount") @db.Decimal(12, 0)
  minimumSubtotal Decimal  @default(0) @map("minimum_subtotal") @db.Decimal(12, 0)
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(6)
  isActive        Boolean  @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  orders          Order[]

  @@map("promotions")
}

model Order {
  paymentStartedAt     DateTime? @map("payment_started_at") @db.Timestamptz(6)
  paymentExpiresAt     DateTime? @map("payment_expires_at") @db.Timestamptz(6)
  paymentExpiredAt     DateTime? @map("payment_expired_at") @db.Timestamptz(6)
  cancellationReason   String? @map("cancellation_reason") @db.VarChar(64)
  paymentAttempts       PaymentAttempt[]
  id                    String                 @id @default(uuid()) @db.Uuid
  orderCode             String                 @unique @map("order_code") @db.Text
  userId                String                 @map("user_id") @db.Uuid
  status                OrderStatus
  redeemedPoints        Int                    @default(0) @map("redeemed_points")
  loyaltyDiscountAmount Decimal                @default(0) @map("loyalty_discount_amount") @db.Decimal(12, 0)
  redemptionState       LoyaltyRedemptionState @default(NONE) @map("redemption_state")
  reservationCycle      Int                    @default(0) @map("reservation_cycle")
  subtotal              Decimal                @db.Decimal(12, 0)
  discountAmount        Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 0)
  total                 Decimal                @db.Decimal(12, 0)
  promotionId           String?                @map("promotion_id") @db.Uuid
  promotionCodeSnapshot String?                @map("promotion_code_snapshot") @db.Text
  version               Int                    @default(0)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  paidAt                DateTime?              @map("paid_at") @db.Timestamptz(6)

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  promotion           Promotion?           @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  payments            Payment[]
  loyaltyAward        LoyaltyAward?
  idempotencyRequests IdempotencyRequest[]
  loyaltyEntries      LoyaltyEntry[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

model AuthSession {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  tokenHash         String @map("token_hash") @db.Char(64)
  previousTokenHash String? @map("previous_token_hash") @db.Char(64)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model OrderItem {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @map("order_id") @db.Uuid
  productId           String             @map("product_id") @db.Uuid
  productNameSnapshot String             @map("product_name_snapshot") @db.Text
  size                String             @db.Text
  basePrice           Decimal            @map("base_price") @db.Decimal(12, 0)
  sizeExtraPrice      Decimal            @map("size_extra_price") @db.Decimal(12, 0)
  unitPrice           Decimal            @map("unit_price") @db.Decimal(12, 0)
  qty                 Int
  lineTotal           Decimal            @map("line_total") @db.Decimal(12, 0)
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  toppings            OrderItemTopping[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemTopping {
  orderItemId         String    @map("order_item_id") @db.Uuid
  toppingId           String    @map("topping_id") @db.Uuid
  toppingNameSnapshot String    @map("topping_name_snapshot") @db.Text
  priceSnapshot       Decimal   @map("price_snapshot") @db.Decimal(12, 0)
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  topping             Topping   @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([orderItemId, toppingId])
  @@index([toppingId])
  @@map("order_item_toppings")
}

model IdempotencyRequest {
  paymentAttempt PaymentAttempt?
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  operation      IdempotencyOperation
  idempotencyKey String               @map("idempotency_key") @db.Text
  requestHash    String               @map("request_hash") @db.Text
  state          IdempotencyState
  orderId        String?              @map("order_id") @db.Uuid
  responseStatus Int?                 @map("response_status") @db.SmallInt
  responseBody   Json?                @map("response_body") @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(6)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment        Payment?

  @@unique([userId, operation, idempotencyKey])
  @@map("idempotency_requests")
}

model Payment {
  provider             PaymentProvider    @default(MOCK)
  gatewayAttemptId     String?            @unique @map("gateway_attempt_id") @db.Uuid
  confirmedAt          DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  gatewayAttempt       PaymentAttempt?    @relation(fields: [gatewayAttemptId], references: [id], onDelete: Restrict)
  id                   String             @id @default(uuid()) @db.Uuid
  orderId              String             @map("order_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  idempotencyRequestId String             @unique @map("idempotency_request_id") @db.Uuid
  idempotencyKey       String             @map("idempotency_key") @db.Text
  amount               Decimal            @db.Decimal(12, 0)
  method               PaymentMethod
  status               PaymentStatus
  failureCode          String?            @map("failure_code") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyRequest   IdempotencyRequest @relation(fields: [idempotencyRequestId], references: [id], onDelete: Restrict)

  loyaltyEntries LoyaltyEntry[]

  // SQL-only: UNIQUE(order_id) WHERE status = 'SUCCEEDED' in init migration.
  @@unique([userId, idempotencyKey])
  @@index([orderId, createdAt])
  @@map("payments")
}

model LoyaltyAward {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @unique @map("order_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  points     Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("loyalty_awards")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               String            @id @default(uuid()) @db.Uuid
  cartId           String            @map("cart_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  size             String            @db.Text
  configurationKey String            @map("configuration_key") @db.Text
  qty              Int
  cart             Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize      ProductSize       @relation(fields: [productId, size], references: [productId, size], onDelete: Restrict)
  toppings         CartItemTopping[]

  @@unique([cartId, configurationKey])
  @@index([productId, size])
  @@map("cart_items")
}

model CartItemTopping {
  cartItemId String   @map("cart_item_id") @db.Uuid
  toppingId  String   @map("topping_id") @db.Uuid
  item       CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  topping    Topping  @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([cartItemId, toppingId])
  @@index([toppingId])
  @@map("cart_item_toppings")
}

model LoyaltyEntry {
  id             String           @id @default(uuid()) @db.Uuid
  sequence       BigInt           @unique @default(autoincrement())
  userId         String           @map("user_id") @db.Uuid
  orderId        String?          @map("order_id") @db.Uuid
  paymentId      String?          @map("payment_id") @db.Uuid
  paymentAttemptId String?         @unique @map("payment_attempt_id") @db.Uuid
  kind           LoyaltyEntryKind
  cycle          Int              @default(0)
  points         Int
  availableDelta Int              @map("available_delta")
  reservedDelta  Int              @map("reserved_delta")
  debtDelta      BigInt           @map("debt_delta")
  effectKey      String           @map("effect_key") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment        Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAttempt PaymentAttempt?  @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@unique([effectKey, kind])
  @@unique([orderId, kind, cycle])
  @@index([userId, sequence(sort: Desc)])
  @@index([orderId, sequence])
  @@map("loyalty_entries")
}
