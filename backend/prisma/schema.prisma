// Docs/DATABASE_DESIGN.md: structural schema; SQL CHECK constraints and the
// partial payment-success unique index are maintained in migrations.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LoyaltyRedemptionState {
  NONE
  RESERVED
  RELEASED
  SETTLED
  REFUNDED
}

enum LoyaltyEntryKind {
  OPENING
  RESERVE
  SETTLE
  RELEASE
  EARN
  REFUND
  REVERSE
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  VNPAY
  ZERO_TOTAL
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
}

enum IdempotencyOperation {
  CREATE_ORDER
  PAY_ORDER
  ADJUST_INVENTORY
}

enum IdempotencyState {
  PROCESSING
  COMPLETED
}

enum PaymentProvider {
  VNPAY_SANDBOX
  INTERNAL_ZERO
  MOCK
}

enum GatewayState {
  AWAITING
  UNKNOWN
  SUCCEEDED
  FAILED
}

enum GatewayApplicationState {
  PENDING
  APPLIED
  REVIEW
}

enum VerificationSource {
  IPN
  QUERYDR
}

enum VerificationState {
  REQUESTED
  VERIFIED
  UNRESOLVED
}

model PaymentAttempt {
  id                   String                  @id @default(dbgenerated("(nextval('payment_attempts_id_seq')::text)")) @db.Text
  orderId              String                  @map("order_id") @db.Text
  idempotencyRequestId String                  @unique @map("idempotency_request_id") @db.Text
  provider             PaymentProvider         @default(VNPAY_SANDBOX)
  merchantCode         String                  @map("merchant_code") @db.VarChar(8)
  txnRef               String                  @unique @map("txn_ref") @db.VarChar(32)
  amount               Decimal                 @db.Decimal(12, 0)
  currency             String                  @default("VND") @db.Char(3)
  state                GatewayState            @default(AWAITING)
  applicationState     GatewayApplicationState @default(PENDING) @map("application_state")
  transactionNo        String?                 @map("transaction_no") @db.VarChar(15)
  responseCode         String?                 @map("response_code") @db.Char(2)
  transactionStatus    String?                 @map("transaction_status") @db.Char(2)
  createDate           String                  @map("create_date") @db.Char(14)
  expiresAt            DateTime                @map("expires_at") @db.Timestamptz(6)
  providerPaidAt       DateTime?               @map("provider_paid_at") @db.Timestamptz(6)
  verifiedAt           DateTime?               @map("verified_at") @db.Timestamptz(6)
  appliedAt            DateTime?               @map("applied_at") @db.Timestamptz(6)
  reviewReason         String?                 @map("review_reason") @db.VarChar(64)
  requestParameters    Json                    @map("request_parameters") @db.JsonB
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  order                Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyRequest   IdempotencyRequest      @relation(fields: [idempotencyRequestId], references: [id], onDelete: Restrict)
  payment              Payment?
  verifications        PaymentVerification[]
  loyaltyEntries       LoyaltyEntry[]

  @@unique([merchantCode, transactionNo])
  @@index([orderId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("payment_attempts")
}

model PaymentVerification {
  id              String             @id @default(dbgenerated("(nextval('payment_verifications_id_seq')::text)")) @db.Text
  attemptId       String             @map("attempt_id") @db.Text
  source          VerificationSource
  state           VerificationState
  requestId       String?            @unique @map("request_id") @db.VarChar(32)
  queryCreateDate String?            @map("query_create_date") @db.Char(14)
  payloadHash     String?            @map("payload_hash") @db.Char(64)
  payload         Json?              @db.JsonB
  errorCode       String?            @map("error_code") @db.VarChar(64)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  attempt         PaymentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, source, payloadHash])
  @@index([attemptId, receivedAt, id])
  @@map("payment_verifications")
}

model User {
  id            String   @id @default(dbgenerated("(nextval('users_id_seq')::text)")) @db.Text
  email         String   @unique @db.Text
  passwordHash  String   @map("password_hash") @db.Text
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  loyaltyDebt   BigInt   @default(0) @map("loyalty_debt")
  role          UserRole @default(CUSTOMER)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  orders                      Order[]
  cart                        Cart?
  payments                    Payment[]
  loyaltyAwards               LoyaltyAward[]
  idempotencyRequests         IdempotencyRequest[]
  loyaltyEntries              LoyaltyEntry[]
  authSessions                AuthSession[]
  ingredientsCreated          Ingredient[]
  ingredientReceipts          IngredientReceipt[]  @relation("ReceiptCreator")
  ingredientReceiptsConfirmed IngredientReceipt[]  @relation("ReceiptConfirmer")
  ingredientCounts            IngredientCount[]    @relation("CountCreator")
  ingredientCountsReviewed    IngredientCount[]    @relation("CountReviewer")
  ingredientMovements         IngredientMovement[]

  @@map("users")
}

enum IngredientUnit {
  KG
  G
  L
  ML
  PIECE
  EGG
}

enum IngredientReceiptStatus {
  DRAFT
  CONFIRMED
}

enum IngredientCountStatus {
  SUBMITTED
  APPROVED
  REJECTED
  RECOUNT_REQUIRED
}

model Ingredient {
  id                String                  @id @default(dbgenerated("(nextval('ingredients_id_seq')::text)")) @db.Text
  name              String                  @db.VarChar(120)
  normalizedName    String                  @unique @map("normalized_name") @db.VarChar(120)
  unit              IngredientUnit
  quantity          Decimal                 @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal                 @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  version           Int                     @default(0)
  createdById       String                  @map("created_by_id") @db.Text
  requestKey        String                  @map("request_key") @db.VarChar(128)
  requestHash       String                  @map("request_hash") @db.Char(64)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy         User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  receiptLines      IngredientReceiptLine[]
  countLines        IngredientCountLine[]
  movements         IngredientMovement[]

  @@unique([createdById, requestKey])
  @@map("ingredients")
}

model IngredientReceipt {
  id            String                  @id @default(dbgenerated("(nextval('ingredient_receipts_id_seq')::text)")) @db.Text
  status        IngredientReceiptStatus @default(DRAFT)
  note          String                  @default("") @db.VarChar(500)
  version       Int                     @default(0)
  createdById   String                  @map("created_by_id") @db.Text
  confirmedById String?                 @map("confirmed_by_id") @db.Text
  requestKey    String                  @map("request_key") @db.VarChar(128)
  requestHash   String                  @map("request_hash") @db.Char(64)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt   DateTime?               @map("confirmed_at") @db.Timestamptz(6)
  createdBy     User                    @relation("ReceiptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy   User?                   @relation("ReceiptConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  lines         IngredientReceiptLine[]

  @@unique([createdById, requestKey])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("ingredient_receipts")
}

model IngredientReceiptLine {
  id           String              @id @default(dbgenerated("(nextval('ingredient_receipt_lines_id_seq')::text)")) @db.Text
  receiptId    String              @map("receipt_id") @db.Text
  ingredientId String              @map("ingredient_id") @db.Text
  quantity     Decimal             @db.Decimal(12, 3)
  receipt      IngredientReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  ingredient   Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  movement     IngredientMovement?

  @@unique([receiptId, ingredientId])
  @@index([ingredientId])
  @@map("ingredient_receipt_lines")
}

model IngredientCount {
  id           String                @id @default(dbgenerated("(nextval('ingredient_counts_id_seq')::text)")) @db.Text
  status       IngredientCountStatus @default(SUBMITTED)
  note         String                @default("") @db.VarChar(500)
  version      Int                   @default(0)
  createdById  String                @map("created_by_id") @db.Text
  reviewedById String?               @map("reviewed_by_id") @db.Text
  reviewNote   String?               @map("review_note") @db.VarChar(500)
  recountOfId  String?               @unique @map("recount_of_id") @db.Text
  requestKey   String                @map("request_key") @db.VarChar(128)
  requestHash  String                @map("request_hash") @db.Char(64)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt   DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  createdBy    User                  @relation("CountCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy   User?                 @relation("CountReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  recountOf    IngredientCount?      @relation("Recount", fields: [recountOfId], references: [id], onDelete: Restrict)
  replacement  IngredientCount?      @relation("Recount")
  lines        IngredientCountLine[]

  @@unique([createdById, requestKey])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc), id(sort: Desc)])
  @@map("ingredient_counts")
}

model IngredientCountLine {
  id                String              @id @default(dbgenerated("(nextval('ingredient_count_lines_id_seq')::text)")) @db.Text
  countId           String              @map("count_id") @db.Text
  ingredientId      String              @map("ingredient_id") @db.Text
  systemQuantity    Decimal             @map("system_quantity") @db.Decimal(12, 3)
  actualQuantity    Decimal             @map("actual_quantity") @db.Decimal(12, 3)
  ingredientVersion Int                 @map("ingredient_version")
  note              String              @default("") @db.VarChar(500)
  count             IngredientCount     @relation(fields: [countId], references: [id], onDelete: Restrict)
  ingredient        Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  movement          IngredientMovement?

  @@unique([countId, ingredientId])
  @@index([ingredientId])
  @@map("ingredient_count_lines")
}

model IngredientMovement {
  id             String                 @id @default(dbgenerated("(nextval('ingredient_movements_id_seq')::text)")) @db.Text
  ingredientId   String                 @map("ingredient_id") @db.Text
  receiptLineId  String?                @unique @map("receipt_line_id") @db.Text
  countLineId    String?                @unique @map("count_line_id") @db.Text
  beforeQuantity Decimal                @map("before_quantity") @db.Decimal(12, 3)
  afterQuantity  Decimal                @map("after_quantity") @db.Decimal(12, 3)
  delta          Decimal                @db.Decimal(13, 3)
  actorId        String                 @map("actor_id") @db.Text
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  ingredient     Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  receiptLine    IngredientReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  countLine      IngredientCountLine?   @relation(fields: [countLineId], references: [id], onDelete: Restrict)
  actor          User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([ingredientId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("ingredient_movements")
}

model Product {
  id        String   @id @default(dbgenerated("('BR' || lpad(nextval('products_id_seq')::text, 3, '0'))")) @db.Text
  name      String   @db.Text
  price     Decimal  @db.Decimal(12, 0)
  imageUrl  String   @map("image_url") @db.Text
  stock     Int
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  sizes     ProductSize[]
  toppings  ProductTopping[]
  items     OrderItem[]
  cartItems CartItem[]

  @@map("products")
}

model ProductSize {
  productId  String     @map("product_id") @db.Text
  size       String     @db.Text
  extraPrice Decimal    @map("extra_price") @db.Decimal(12, 0)
  isActive   Boolean    @default(true) @map("is_active")
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]

  @@id([productId, size])
  @@map("product_sizes")
}

model Topping {
  id        String   @id @default(dbgenerated("(nextval('toppings_id_seq')::text)")) @db.Text
  name      String   @db.Text
  price     Decimal  @db.Decimal(12, 0)
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  products  ProductTopping[]
  items     OrderItemTopping[]
  cartItems CartItemTopping[]

  @@map("toppings")
}

model ProductTopping {
  productId String  @map("product_id") @db.Text
  toppingId String  @map("topping_id") @db.Text
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([productId, toppingId])
  @@index([toppingId])
  @@map("product_toppings")
}

model Promotion {
  id              String   @id @default(dbgenerated("(nextval('promotions_id_seq')::text)")) @db.Text
  code            String   @unique @db.Text
  discountAmount  Decimal  @map("discount_amount") @db.Decimal(12, 0)
  minimumSubtotal Decimal  @default(0) @map("minimum_subtotal") @db.Decimal(12, 0)
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(6)
  isActive        Boolean  @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  orders          Order[]

  @@map("promotions")
}

model Order {
  paymentStartedAt      DateTime?              @map("payment_started_at") @db.Timestamptz(6)
  paymentExpiresAt      DateTime?              @map("payment_expires_at") @db.Timestamptz(6)
  paymentExpiredAt      DateTime?              @map("payment_expired_at") @db.Timestamptz(6)
  cancellationReason    String?                @map("cancellation_reason") @db.VarChar(64)
  paymentAttempts       PaymentAttempt[]
  id                    String                 @id @default(dbgenerated("(nextval('orders_id_seq')::text)")) @db.Text
  orderCode             String                 @unique @map("order_code") @db.Text
  userId                String                 @map("user_id") @db.Text
  status                OrderStatus
  redeemedPoints        Int                    @default(0) @map("redeemed_points")
  loyaltyDiscountAmount Decimal                @default(0) @map("loyalty_discount_amount") @db.Decimal(12, 0)
  redemptionState       LoyaltyRedemptionState @default(NONE) @map("redemption_state")
  reservationCycle      Int                    @default(0) @map("reservation_cycle")
  subtotal              Decimal                @db.Decimal(12, 0)
  discountAmount        Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 0)
  total                 Decimal                @db.Decimal(12, 0)
  promotionId           String?                @map("promotion_id") @db.Text
  promotionCodeSnapshot String?                @map("promotion_code_snapshot") @db.Text
  version               Int                    @default(0)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  paidAt                DateTime?              @map("paid_at") @db.Timestamptz(6)

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  promotion           Promotion?           @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  payments            Payment[]
  loyaltyAward        LoyaltyAward?
  idempotencyRequests IdempotencyRequest[]
  loyaltyEntries      LoyaltyEntry[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

model AuthSession {
  id                String    @id @default(dbgenerated("(nextval('auth_sessions_id_seq')::text)")) @db.Text
  userId            String    @map("user_id") @db.Text
  tokenHash         String    @map("token_hash") @db.Char(64)
  previousTokenHash String?   @map("previous_token_hash") @db.Char(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model OrderItem {
  id                  String             @id @default(dbgenerated("(nextval('order_items_id_seq')::text)")) @db.Text
  orderId             String             @map("order_id") @db.Text
  productId           String             @map("product_id") @db.Text
  productNameSnapshot String             @map("product_name_snapshot") @db.Text
  size                String             @db.Text
  basePrice           Decimal            @map("base_price") @db.Decimal(12, 0)
  sizeExtraPrice      Decimal            @map("size_extra_price") @db.Decimal(12, 0)
  unitPrice           Decimal            @map("unit_price") @db.Decimal(12, 0)
  qty                 Int
  lineTotal           Decimal            @map("line_total") @db.Decimal(12, 0)
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  toppings            OrderItemTopping[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemTopping {
  orderItemId         String    @map("order_item_id") @db.Text
  toppingId           String    @map("topping_id") @db.Text
  toppingNameSnapshot String    @map("topping_name_snapshot") @db.Text
  priceSnapshot       Decimal   @map("price_snapshot") @db.Decimal(12, 0)
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  topping             Topping   @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([orderItemId, toppingId])
  @@index([toppingId])
  @@map("order_item_toppings")
}

model IdempotencyRequest {
  paymentAttempt PaymentAttempt?
  id             String               @id @default(dbgenerated("(nextval('idempotency_requests_id_seq')::text)")) @db.Text
  userId         String               @map("user_id") @db.Text
  operation      IdempotencyOperation
  idempotencyKey String               @map("idempotency_key") @db.Text
  requestHash    String               @map("request_hash") @db.Text
  state          IdempotencyState
  orderId        String?              @map("order_id") @db.Text
  responseStatus Int?                 @map("response_status") @db.SmallInt
  responseBody   Json?                @map("response_body") @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(6)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment        Payment?

  @@unique([userId, operation, idempotencyKey])
  @@map("idempotency_requests")
}

model Payment {
  provider             PaymentProvider    @default(VNPAY_SANDBOX)
  gatewayAttemptId     String?            @unique @map("gateway_attempt_id") @db.Text
  confirmedAt          DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  gatewayAttempt       PaymentAttempt?    @relation(fields: [gatewayAttemptId], references: [id], onDelete: Restrict)
  id                   String             @id @default(dbgenerated("(nextval('payments_id_seq')::text)")) @db.Text
  orderId              String             @map("order_id") @db.Text
  userId               String             @map("user_id") @db.Text
  idempotencyRequestId String             @unique @map("idempotency_request_id") @db.Text
  idempotencyKey       String             @map("idempotency_key") @db.Text
  amount               Decimal            @db.Decimal(12, 0)
  method               PaymentMethod      @default(VNPAY)
  status               PaymentStatus
  failureCode          String?            @map("failure_code") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyRequest   IdempotencyRequest @relation(fields: [idempotencyRequestId], references: [id], onDelete: Restrict)

  loyaltyEntries LoyaltyEntry[]

  // SQL-only: UNIQUE(order_id) WHERE status = 'SUCCEEDED' in init migration.
  @@unique([userId, idempotencyKey])
  @@index([orderId, createdAt])
  @@map("payments")
}

model LoyaltyAward {
  id         String    @id @default(dbgenerated("(nextval('loyalty_awards_id_seq')::text)")) @db.Text
  orderId    String    @unique @map("order_id") @db.Text
  userId     String    @map("user_id") @db.Text
  points     Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("loyalty_awards")
}

model Cart {
  id        String     @id @default(dbgenerated("(nextval('carts_id_seq')::text)")) @db.Text
  userId    String     @unique @map("user_id") @db.Text
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               String            @id @default(dbgenerated("(nextval('cart_items_id_seq')::text)")) @db.Text
  cartId           String            @map("cart_id") @db.Text
  productId        String            @map("product_id") @db.Text
  size             String            @db.Text
  configurationKey String            @map("configuration_key") @db.Text
  qty              Int
  cart             Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize      ProductSize       @relation(fields: [productId, size], references: [productId, size], onDelete: Restrict)
  toppings         CartItemTopping[]

  @@unique([cartId, configurationKey])
  @@index([productId, size])
  @@map("cart_items")
}

// note
model CartItemTopping {
  cartItemId String   @map("cart_item_id") @db.Text
  toppingId  String   @map("topping_id") @db.Text
  item       CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  topping    Topping  @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([cartItemId, toppingId])
  @@index([toppingId])
  @@map("cart_item_toppings")
}

model LoyaltyEntry {
  id               String           @id @default(dbgenerated("(nextval('loyalty_entries_id_seq')::text)")) @db.Text
  sequence         BigInt           @unique @default(autoincrement())
  userId           String           @map("user_id") @db.Text
  orderId          String?          @map("order_id") @db.Text
  paymentId        String?          @map("payment_id") @db.Text
  paymentAttemptId String?          @unique @map("payment_attempt_id") @db.Text
  kind             LoyaltyEntryKind
  cycle            Int              @default(0)
  points           Int
  availableDelta   Int              @map("available_delta")
  reservedDelta    Int              @map("reserved_delta")
  debtDelta        BigInt           @map("debt_delta")
  effectKey        String           @map("effect_key") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment          Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAttempt   PaymentAttempt?  @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@unique([effectKey, kind])
  @@unique([orderId, kind, cycle])
  @@index([userId, sequence(sort: Desc)])
  @@index([orderId, sequence])
  @@map("loyalty_entries")
}
