# Copy to .env at the repository root for local development.
NODE_ENV=development
# Backend HTTP port; frontend uses 3000.
PORT=3001
# Browser origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000
# Sample credentials only. PostgreSQL must be started separately.
DATABASE_URL=postgresql://brewlite:example_password@localhost:5432/brewlite_dev?schema=public
# Generate a random secret locally (at least 32 bytes); never commit real values.
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
# Seconds, locked to the approved one-hour JWT lifetime.
JWT_EXPIRES_IN=3600
# Server-only deterministic mock. Restart backend after changing mode.
PAYMENT_MOCK_MODE=SUCCESS
PAYMENT_PROVIDER_MODE=MOCK

# Optional frontend-only synthetic browser verification. Export in the shell;
# gateway-browser.mjs does not load private .env files or merchant credentials.
# BROWSER_PATH=<path-to-your-installed-chromium-or-edge>
# BREWLITE_BROWSER_BUILD_DIR=.tmp/c2-dev-frontend
# BREWLITE_BROWSER_EVIDENCE_PREFIX=c2-browser

# Default MOCK requires no merchant values. VNPAY production is always denied.
# Development Sandbox also requires PAYMENT_PROVIDER_MODE=VNPAY_SANDBOX and valid
# privately supplied credentials/callbacks. Use npm run dev:vnpay for normal local
# operation; see Docs/NORMAL_SANDBOX_MODE.md. No per-payment session approval.
VNPAY_SANDBOX_ENABLED=false
# false = DRAIN_ONLY: retain the same mode/profile/key, reject new positive Orders
# and new Attempts, but keep existing IPN/Return/status/recovery available.
# Restart backend after changes; no hot-toggle API. Do not switch to MOCK while draining.
VNPAY_ACCEPT_NEW_PAYMENTS=false
# These are safe placeholders, not merchant configuration. The optional private
# .env.vnpay.local overlay is read only by the normal VNPAY launcher.
# VNPAY_ENV=SANDBOX
# VNPAY_VERSION=2.1.0
# VNPAY_TMN_CODE=YOURCODE
# VNPAY_HASH_SECRET=replace_with_merchant_issued_secret
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=https://your-callback-host.example/payments/vnpay/return
# VNPAY_IPN_URL=https://your-callback-host.example/payments/vnpay/ipn
# Optional, must match this existing P00 local-browser destination exactly.
# VNPAY_RESULT_URL=http://localhost:3000/payments/vnpay/result
# Callback ingress has fixed loopback3102 -> loopback3001; no proxy target env switch.
# See Docs/P01D1_LOCAL_CALLBACK_INGRESS.md before any future ngrok/merchant setup.
