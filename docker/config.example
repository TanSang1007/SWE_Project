# Copy to docker/local.env. Keep this private. Password: letters/digits only (URL-safe).
DOCKER_DB_PASSWORD=replace_with_random_alphanumeric_password
DOCKER_JWT_SECRET=replace_with_random_secret_at_least_32_bytes
DOCKER_VNPAY_TMN_CODE=YOURCODE
DOCKER_VNPAY_HASH_SECRET=replace_with_merchant_issued_secret
# HTTPS origin registered with this merchant; no trailing slash.
DOCKER_CALLBACK_ORIGIN=https://your-registered-domain.ngrok-free.dev
DOCKER_ACCEPT_PAYMENTS=false
